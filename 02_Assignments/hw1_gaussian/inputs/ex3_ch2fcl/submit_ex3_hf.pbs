#!/bin/bash
#PBS -N hw1_ex3_hf
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=6gb
#PBS -l walltime=02:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"

module purge
module load Gaussian/g16

export GAUSS_SCRDIR=/hpctmp/zhangxubo/gauss_${PBS_JOBID}
mkdir -p "$GAUSS_SCRDIR"

g16 < 01a_ch2fcl_hf_sto3g.gjf > 01a_ch2fcl_hf_sto3g.log 2>&1

rm -rf "$GAUSS_SCRDIR"
