#!/bin/bash
#PBS -N hw1_ex3_ccsd
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=10gb
#PBS -l walltime=96:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"

module purge
module load Gaussian/g16

export GAUSS_SCRDIR=/hpctmp/zhangxubo/gauss_${PBS_JOBID}
mkdir -p "$GAUSS_SCRDIR"

g16 < 01c_ch2fcl_ccsd_ccpvtz.gjf > 01c_ch2fcl_ccsd_ccpvtz.log 2>&1

rm -rf "$GAUSS_SCRDIR"
