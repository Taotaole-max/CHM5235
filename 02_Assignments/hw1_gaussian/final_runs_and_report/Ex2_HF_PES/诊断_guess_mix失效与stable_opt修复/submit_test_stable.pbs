#!/bin/bash
#PBS -N ex2_test_stable
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=6gb
#PBS -l walltime=00:30:00
#PBS -j oe

cd "$PBS_O_WORKDIR"

module purge
module load Gaussian/g16

export GAUSS_SCRDIR=/hpctmp/zhangxubo/gauss_${PBS_JOBID}
mkdir -p "$GAUSS_SCRDIR"

g16 < test_stable.gjf > test_stable.log 2>&1

rm -rf "$GAUSS_SCRDIR"
