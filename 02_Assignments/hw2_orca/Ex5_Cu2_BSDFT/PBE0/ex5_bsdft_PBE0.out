NAME = ex5_bsdft_PBE0.inp
|  1> # Ex5 extra run -- functional sensitivity: PBE0 (25% HF exchange) instead of B3LYP, non-relativistic, same SVP basis.
|  2> # Same BS-DFT setup as the three required calculations: charge -2, high-spin multiplicity 3,
|  3> # BrokenSym 1,1. Only the functional (or the basis) is changed, so the effect can be separated
|  4> # from the relativistic treatment.
|  5> ! UKS PBE0 def2-SVP def2/J RIJCOSX TightSCF SlowConv
|  6> 
|  7> %maxcore 6000
|  8> 
|  9> %scf
| 10>   BrokenSym 1,1
| 11>   MaxIter   500
| 12> end
| 13> 
| 14> * xyzfile -2 3 ../ex5_Cu2_geometry_from_canvas.xyz
| 15> 
| 16>                          ****END OF INPUT****
