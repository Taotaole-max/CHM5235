NAME = ex5_bsdft_ZORA.inp
|  1> # Ex5  Cu(II)-Cu(II) magnetic exchange J by broken-symmetry DFT  --  scalar-relativistic, zeroth-order regular approximation
|  2> # All three Ex5 jobs use the same functional (B3LYP) and the same basis size (SVP),
|  3> # so the only difference between them is the relativistic treatment.
|  4> #
|  5> # BrokenSym 1,1: ORCA first converges the high-spin state (Ms = 1, both Cu spins up), then flips
|  6> # the unpaired electron on one Cu and converges the broken-symmetry state (Ms = 0). At the end it
|  7> # prints E(HS), E(BS), <S**2> of both states and J from three formulas, with the convention
|  8> # H = -2J S1.S2 (J < 0 = antiferromagnetic).
|  9> # Charge -2 as given in the assignment; the coordinate line carries the HIGH-SPIN multiplicity
| 10> # 2*(1/2 + 1/2) + 1 = 3.
| 11> ! UKS B3LYP ZORA ZORA-def2-SVP SARC/J RIJCOSX TightSCF SlowConv
| 12> 
| 13> %maxcore 6000
| 14> 
| 15> %scf
| 16>   BrokenSym 1,1   # one unpaired electron on each Cu(II), d9
| 17>   MaxIter   500
| 18> end
| 19> 
| 20> * xyzfile -2 3 ../ex5_Cu2_geometry_from_canvas.xyz
| 21> 
| 22>                          ****END OF INPUT****
