NAME = ex1_optfreq_PBE_water.inp
|  1> # Ex1  2-chlorophenol  UKS PBE/def2-TZVP  CPCM water
|  2> # Opt + analytic Freq. Charges, dipole, orbital energies and 298.15 K thermochemistry
|  3> # (entropy) are all printed by default.
|  4> # PBE has no HF exchange, so only RI-J (def2/J) is needed
|  5> ! UKS PBE def2-TZVP def2/J TightSCF TightOpt Opt Freq CPCM(Water)
