================================================================================
                                       INPUT FILE
================================================================================
NAME = ex1_sp_for_plots_B3LYP_gas.inp
|  1> # Ex1 figures: single point on the Ex1 B3LYP (gas) optimized geometry, only to write cube files.
|  2> # Same method as Ex1 (UKS B3LYP/def2-TZVP), so the orbitals and density are those of Ex1.
|  3> # The %plots box (bohr) is the same box as the ESP grid in ex1_esp_grid_points_bohr.xyz,
|  4> # spacing about 0.3 bohr. HOMO = orbital 32, LUMO = orbital 33 (alpha, operator 0).
|  5> ! UKS B3LYP def2-TZVP def2/J RIJCOSX TightSCF
|  6> 
|  7> %maxcore 4000
|  8> 
|  9> %plots
| 10>   dim1 64
| 11>   dim2 97
| 12>   dim3 94
| 13>   min1 -9.5
| 14>   max1  9.5
| 15>   min2 -15.0
| 16>   max2  14.0
| 17>   min3 -13.5
| 18>   max3  14.5
| 19>   Format Gaussian_Cube
| 20>   MO("ex1_cube_HOMO_B3LYP_gas.cube", 32, 0);
| 21>   MO("ex1_cube_LUMO_B3LYP_gas.cube", 33, 0);
| 22>   ElDens("ex1_cube_density_B3LYP_gas.cube");
| 23> end
| 24> 
| 25> * xyzfile 0 1 ex1_optimized_geometry_B3LYP_gas.xyz
| 26> 
| 27>                          ****END OF INPUT****
