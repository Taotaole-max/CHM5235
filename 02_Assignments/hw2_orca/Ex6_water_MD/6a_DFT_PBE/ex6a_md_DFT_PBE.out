NAME = ex6a_md_DFT_PBE.inp
|  1> # Ex6a  cluster of 20 water molecules cut from ice, 400 K, Nose-Hoover chain thermostat
|  2> # (a) ab initio MD, PBE/def2-SVP, small cluster
|  3> # 200 steps x 0.5 fs = 100 fs. The ORCA manual recommends a time step of at most 0.5 fs
|  4> # for systems containing hydrogen.
|  5> #
|  6> # Cell Sphere cx, cy, cz, r: soft harmonic wall that keeps molecules evaporating from the hot cluster
|  7> # from flying away. "Sphere of size 50 A" is read as diameter 50 A -> r = 25 A. The centre is the
|  8> # geometric centre of the cluster (the xyz is not centred at the origin); the cluster itself has a
|  9> # radius of only 6.4 A, so the wall acts only on molecules that leave the cluster.
| 10> ! MD PBE def2-SVP def2/J
| 11> 
| 12> %maxcore 6000
| 13> 
| 14> %md
| 15>   Timestep   0.5_fs
| 16>   Initvel    400_K
| 17>   Thermostat NHC 400_K Timecon 10.0_fs
| 18>   Cell       Sphere 1.901, 3.292, 3.750, 25.0
| 19>   Dump       Position Stride 1 Filename "ex6a_trajectory_DFT_PBE.xyz"
| 20>   Run        200
| 21> end
| 22> 
| 23> * xyzfile 0 1 ../ex6a_water_cluster_20H2O_for_DFT.xyz
| 24> 
| 25>                          ****END OF INPUT****
