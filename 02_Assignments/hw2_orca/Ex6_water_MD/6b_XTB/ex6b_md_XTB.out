NAME = ex6b_md_XTB.inp
|  1> # Ex6b  cluster of 128 water molecules cut from ice, 400 K, Nose-Hoover chain thermostat
|  2> # (b) semi-empirical MD, GFN2-xTB (ORCA calls the bundled otool_xtb), large cluster
|  3> # 5000 steps x 0.5 fs = 2500 fs. The ORCA manual recommends a time step of at most 0.5 fs
|  4> # for systems containing hydrogen.
|  5> #
|  6> # Cell Sphere cx, cy, cz, r: soft harmonic wall that keeps molecules evaporating from the hot cluster
|  7> # from flying away. "Sphere of size 50 A" is read as diameter 50 A -> r = 25 A. The centre is the
|  8> # geometric centre of the cluster (the xyz is not centred at the origin); the cluster itself has a
|  9> # radius of only 13.7 A, so the wall acts only on molecules that leave the cluster.
| 10> ! MD XTB2
| 11> 
| 12> %md
| 13>   Timestep   0.5_fs
| 14>   Initvel    400_K
| 15>   Thermostat NHC 400_K Timecon 10.0_fs
| 16>   Cell       Sphere 3.802, 6.585, 7.322, 25.0
| 17>   Dump       Position Stride 1 Filename "ex6b_trajectory_XTB.xyz"
| 18>   Run        5000
| 19> end
| 20> 
| 21> * xyzfile 0 1 ../ex6b_water_cluster_128H2O_for_XTB.xyz
| 22> 
| 23>                          ****END OF INPUT****
================================================================================

