================================================================================
                                       INPUT FILE
================================================================================
NAME = ex4_tddft_PBE_gas.inp
|  1> # Ex4  2-chlorophenol  TD-DFT, first 5 excited states  --  PBE/def2-TZVP, gas phase
|  2> # Geometry: the optimized structure of the same method in Ex1, copied here by ex4_run_one_method.pbs
|  3> # as ex4_input_geometry_from_ex1_PBE_gas.xyz.
|  4> # RKS instead of UKS: the molecule is closed-shell, so the ground state is identical, and TD-DFT on
|  5> # RKS gives pure singlet states. With UKS the 5 roots would mix in triplets (zero oscillator
|  6> # strength) and the UV spectrum would lose peaks.
|  7> ! RKS PBE def2-TZVP def2/J TightSCF
|  8> 
|  9> %maxcore 6000
| 10> 
| 11> %tddft
| 12>   NRoots 5        # first 5 excited states
| 13>   TDA    false    # full TD-DFT instead of the Tamm-Dancoff approximation: better oscillator strengths
| 14> end
| 15> 
| 16> * xyzfile 0 1 ex4_input_geometry_from_ex1_PBE_gas.xyz
| 17> 
| 18>                          ****END OF INPUT****
