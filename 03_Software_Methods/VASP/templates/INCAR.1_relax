SYSTEM = structure relaxation

# ---- 起始设置 ----
ISTART = 0          # 0 = 从头开始（不读 WAVECAR）
ICHARG = 2          # 2 = 用原子电荷密度叠加作初始猜测

# ---- 精度 ----
PREC   = Accurate
ENCUT  = 520        # 平面波截断能 (eV)。规矩：≥ POTCAR 里最大 ENMAX 的 1.3 倍
                    # 做 ISIF=3 变胞优化时尤其要给足，否则有 Pulay 应力误差
EDIFF  = 1E-6       # 电子步收敛判据 (eV)
LREAL  = Auto       # 投影算符在实空间做，原子数 >20 时明显加速；小体系可设 .FALSE. 更精确

# ---- 离子步（结构优化）----
IBRION = 2          # 2 = 共轭梯度法，最稳健的通用选择
ISIF   = 3          # 2 = 只动原子；3 = 原子+晶胞形状+体积都优化
                    # 【2D 材料用 4】：优化原子和形状但保持体积，避免真空层被压扁
NSW    = 200        # 最大离子步数
EDIFFG = -0.01      # 负数 = 力的判据 (eV/Å)，所有原子受力 < 0.01 时停
                    # 正数则是能量判据

# ---- 电子占据 ----
ISMEAR = 0          # 0 = 高斯展宽，半导体/分子/未知体系的安全选择
SIGMA  = 0.05       # 展宽宽度 (eV)
                    # 金属用 ISMEAR = 1 或 2，SIGMA = 0.1~0.2
                    # 最终精确 DOS 用 ISMEAR = -5 (四面体法)

# ---- 输出控制 ----
LWAVE  = .FALSE.    # 不写 WAVECAR（很大，优化阶段不需要）
LCHARG = .FALSE.

# ---- 并行 ----
NCORE  = 4          # 每个能带用几个核。经验值 = sqrt(总核数)，或设成每节点核数的因子

# ---- 色散校正（2D 材料、层状材料、吸附体系必加）----
# IVDW = 12         # DFT-D3 with Becke-Johnson damping
