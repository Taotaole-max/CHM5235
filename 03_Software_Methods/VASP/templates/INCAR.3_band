SYSTEM = band structure (non-self-consistent)

# 前置：把 SCF 步产生的 CHGCAR 留在当前目录
# KPOINTS 必须换成【线模式】沿高对称路径取点（见 KPOINTS.line）

ISTART = 1
ICHARG = 11         # ★ 11 = 固定读取 CHGCAR，做非自洽计算
                    #   能带计算的标志性设置

PREC   = Accurate
ENCUT  = 520
EDIFF  = 1E-6
LREAL  = .FALSE.

IBRION = -1
NSW    = 0

ISMEAR = 0
SIGMA  = 0.05

LORBIT = 11         # 输出 PROCAR，含轨道投影信息 → 可以画投影能带（哪条带是什么轨道贡献的）

LWAVE  = .FALSE.
LCHARG = .FALSE.

NCORE  = 4
